FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-this
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# PostgreSQL in production; SQLite is used locally when DATABASE_URL starts with sqlite:///
DATABASE_URL=sqlite:///./deepsearch.db

# Temporary ingestion workspace only. Originals are persisted to S3-compatible storage.
UPLOAD_DIR=/tmp/deepsearch
LOCAL_STORAGE_DIR=./storage

# Object storage
# local for development; s3 for AWS S3 / Cloudflare R2 / MinIO
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI: same Groq setup as Retail Mind
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Embeddings / semantic retrieval
EMBEDDING_MODEL_REPO=Xenova/all-MiniLM-L6-v2
HF_HOME=/tmp/.cache/huggingface

# Optional Render Key Value / Redis
REDIS_URL=

DEBUG=true
